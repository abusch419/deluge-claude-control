{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/dev/deluge-claude/signal.py session_start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/dev/deluge-claude/signal.py session_end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
