<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the Centcom -> Deluge bridge (replaces the hooks and the old watch service).

  Setup:
    1. Replace BOTH /path/to/deluge-claude paths below with your absolute clone
       path, and replace USERNAME in the log paths with your macOS user (or point
       them anywhere writable).
    2. Copy this file to ~/Library/LaunchAgents/com.deluge-claude.bridge.plist
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.deluge-claude.bridge.plist
       launchctl enable    gui/$(id -u)/com.deluge-claude.bridge

  RunAtLoad + KeepAlive = starts at login and restarts if it ever exits.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.deluge-claude.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/deluge-claude/.venv/bin/python3</string>
        <string>/path/to/deluge-claude/bridge.py</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/.claude/deluge_bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/.claude/deluge_bridge.log</string>
</dict>
</plist>
