{
  "_comment": "Claude Code hooks for the Deluge status display. Copy the 'hooks' block into your OWN .claude/settings.local.json (project-level) or ~/.claude/settings.json (global). Replace /path/to/deluge-claude with the absolute path where you cloned this repo. If you already have a 'hooks' block, merge these events into it. Restart Claude Code afterward so it loads the hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/deluge-claude/signal.py session_start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/deluge-claude/signal.py session_end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/deluge-claude/signal.py working"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/deluge-claude/signal.py permission_request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/deluge-claude/signal.py posttool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/deluge-claude/signal.py stop"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/deluge-claude/signal.py subagent_start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/deluge-claude/signal.py subagent_stop"
          }
        ]
      }
    ]
  }
}
